{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push origin main:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m pip install:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(bash scripts/*.sh:*)",
      "Bash(chmod:*)",
      "Bash(latexmk:*)",
      "Bash(biber:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git rebase -i:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  }
}
