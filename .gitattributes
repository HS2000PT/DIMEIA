# Normaliza fins de linha para LF em todos os dispositivos (evita churn no diff)
* text=auto eol=lf

# Marca binários (não fazer merge/diff de texto)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.parquet binary
*.synctex.gz binary

# Scripts shell sempre LF
*.sh text eol=lf
