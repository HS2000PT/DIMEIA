# systemd unit — vigia contínuo do InvestiGator numa VM (Oracle Free ou outra Linux).
# Instalação: ver docs/design/vm_watch.md (o setup_vm.sh faz isto por ti).
#   sudo cp deploy/investigator-watch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now investigator-watch

[Unit]
Description=InvestiGator — vigia continuo de alertas (scripts/run_alerts.py --watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=investigator
WorkingDirectory=/home/investigator/DIMEIA
# .env (segredos) e histórico partilhado (checkout git da branch alerts-history):
Environment=INVESTIGATOR_HISTORY_PATH=/home/investigator/alerts-history/alerts_history.jsonl
Environment=INVESTIGATOR_HISTORY_GIT=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/investigator/DIMEIA/.venv/bin/python scripts/run_alerts.py --watch --interval 300
Restart=always
RestartSec=30
# Paragem limpa: o loop apanha SIGTERM e termina no fim do ciclo.
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
